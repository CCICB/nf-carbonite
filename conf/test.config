/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-carbonite test config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal profile to exercise the pipeline wiring with the bundled dummy data.
    The reference files are placeholders, so this profile is intended for stub
    runs, which don't execute the real tools (and therefore need no containers):

        nextflow run . -profile test -stub-run --outdir test_results

    NOTE: the samplesheet references its FASTQ directory by a path relative to
    the launch directory, so run this from the repository root.
----------------------------------------------------------------------------------------
*/

params {
    input          = "${projectDir}/assets/test_data/samplesheet.csv"
    genome_lib_dir = "${projectDir}/assets/test_data/genome_lib"
    star_dir       = "${projectDir}/assets/test_data/star"
    gtf_file       = "${projectDir}/assets/test_data/annotation.gtf"
    ensg2hgnc_file = "${projectDir}/assets/test_data/ensg2hgnc.csv"

    reference_name     = 'test_ref'
    ref_genome_version = 'hs38'
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
