/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-carbonite Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Load the nf-schema plugin for parameter/samplesheet validation (requires Nextflow >=24.10.0)
plugins {
    id 'nf-schema@2.5.1'
}

// Global default params, used in configs
params {
    input = null
    outdir = null

    // Boilerplate options
    tracedir                   = "${params.outdir}/pipeline_info"
    version                    = false

    publish_dir_mode           = "copy"

    mixcr_license = null
    genome_lib_dir = null
    star_dir  = null
    gtf_file = null
    te_gtf_file = null
    rnaindel_dir = null
    mintie_dir = null
    annovar_dir = null
    ensembl_data_dir = null
    freebayes_interval_list = null
    gatk_interval_list = null
    ensg2hgnc_file = null

    // Toggle T/ALLSorts
    run_allsorts  = true
    run_tallsorts = true

    // App versions
    allsorts_version = '0.2.0'
    arriba_version = '2.4.0'

    // Analysis config
    reference_name = "GRCh38_no_alt_analysis_set"
    ref_genome_version = 'hs38'

}
// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    base { includeConfig 'conf/base.config'}
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled = true
        // Avoid this error:
        //   WARNING: Your kernel does not support swap limit capabilities or the cgroup is not mounted. Memory limited without swap.
        // Testing this in nf-core after discussion here https://github.com/nf-core/tools/pull/351
        // once this is established and works well, nextflow might implement this behavior as new default.
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        docker.temp = "auto"
      }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    test { includeConfig 'conf/test.config' }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    tower { includeConfig 'conf/tower.config'}
    cavatica { includeConfig 'conf/cavatica.config'}
    local { includeConfig 'conf/local.config' }
    pawsey { includeConfig 'conf/pawsey.config'}
    nci { includeConfig 'conf/nci.config'}
    s3 { includeConfig 'conf/s3.config'}
}


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// nf-schema plugin settings (parameter validation and --help)
validation {
    help {
        enabled = true
        command = "nextflow run CCICB/nf-carbonite -profile <docker/singularity> --input samples.csv --outdir <OUTDIR> -params-file params.yaml"
    }
    // Params set only by institutional profiles, not part of the pipeline schema
    defaultIgnoreParams = ['config_profile_description', 'config_profile_contact', 'config_profile_url']
}

def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
    overwrite = true
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/pipeline_dag_${trace_timestamp}.html"
}

manifest {
    name            = 'nf-carbonite'
    author          = """Computational Biology, Children's Cancer Institute"""
    homePage        = 'https://github.com/CCICB/nf-carbonite'
    description     = """Carbonite - An RNA-Seq analysis workflow"""
    mainScript      = 'main.nf'
    // '!' = strict: abort (instead of warn) on older Nextflow.
    // Floor is 24.10.0: resourceLimits needs >=24.04.0, the nf-schema 2.5.x plugin needs >=24.10.0.
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0'
    doi             = ''
}
